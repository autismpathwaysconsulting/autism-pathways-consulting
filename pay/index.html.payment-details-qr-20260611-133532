      margin-top: 14px;
      padding: 12px 14px;
      border-radius: 13px;
      background: rgba(232, 153, 122, 0.12);
      border: 1px solid rgba(232, 153, 122, 0.24);
      color: #5a352a;
      font-size: 0.91rem;
      font-weight: 700;
      line-height: 1.42;
    }

    .payment-details {
