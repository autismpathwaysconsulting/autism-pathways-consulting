      padding: clamp(17px, 2.8vw, 24px);
      border-radius: var(--radius);
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .payment-details h2 {
      margin: 0 0 7px;
      color: var(--teal-dark);
      font-size: clamp(1.3rem, 2.4vw, 1.9rem);
      line-height: 1.12;
      letter-spacing: -0.04em;
    }

    .payment-details-intro {
      margin: 0 0 14px;
      max-width: 760px;
      color: var(--muted);
      font-size: 0.93rem;
      line-height: 1.48;
    }

    .payment-methods {
      display: grid;
      grid-template-columns: 1fr 0.75fr;
      gap: 13px;
      align-items: stretch;
    }

    .payment-method-card {
      padding: 15px;
      border-radius: 15px;
      background: #f7fbf8;
      border: 1px solid rgba(7, 55, 52, 0.09);
    }

    .payment-method-card h3 {
      margin: 0 0 9px;
      color: var(--teal-dark);
      font-size: 1rem;
      line-height: 1.2;
    }

    .bank-row {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 10px;
      padding: 7px 0;
      border-bottom: 1px solid rgba(7, 55, 52, 0.09);
    }

    .bank-row:last-child {
      border-bottom: 0;
    }

    .bank-row span {
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 850;
    }

    .bank-row strong {
      color: var(--teal-dark);
      font-weight: 900;
      word-break: break-word;
    }

    .qr-box {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 190px;
      text-align: center;
    }

    .qr-box img {
      width: min(175px, 100%);
      height: auto;
      border-radius: 14px;
      background: #ffffff;
      border: 1px solid rgba(7, 55, 52, 0.12);
      padding: 7px;
    }

    .payment-confirmation {
      margin-top: 13px;
      padding: 12px 14px;
      border-radius: 13px;
      background: rgba(232, 153, 122, 0.12);
      border: 1px solid rgba(232, 153, 122, 0.24);
      color: #5a352a;
      font-size: 0.91rem;
      font-weight: 750;
      line-height: 1.45;
    }

    .whatsapp-confirm-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      margin-top: 13px;
      padding: 12px 18px;
      border-radius: 999px;
      background: var(--teal-dark);
      color: var(--cream);
      text-decoration: none;
      font-weight: 950;
      text-align: center;
    }

    .boundary {
      margin: 13px 0 0;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.45;
    }

    footer {
      margin-top: 24px;
      padding: 20px 0 30px;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.88rem;
    }

    @media (max-width: 980px) {
      .option-tabs {
        grid-template-columns: 1fr;
      }

      .nav {
        align-items: flex-start;
        flex-direction: column;
        padding: 14px 0;
      }

      .nav-links {
        flex-wrap: wrap;
        gap: 12px;
      }

      .steps-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .details-top,
      .payment-methods {
        grid-template-columns: 1fr;
      }

      .details-price {
        text-align: left;
      }
    }

    @media (max-width: 760px) {
      .steps-grid,
      .includes {
        grid-template-columns: 1fr;
      }

      .bank-row {
        grid-template-columns: 1fr;
        gap: 2px;
      }

      .whatsapp-confirm-button {
        width: 100%;
      }
    }
  </style>







