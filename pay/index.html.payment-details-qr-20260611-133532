  <style>
    :root {
      --teal-dark: #073734;
      --teal: #0f766e;
      --teal-soft: #e7f6f3;
      --cream: #fffaf3;
      --card: #ffffff;
      --coral: #e8997a;
      --text: #173834;
      --muted: rgba(23, 56, 52, 0.68);
      --border: rgba(7, 55, 52, 0.13);
      --shadow: 0 10px 28px rgba(7, 55, 52, 0.07);
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Inter, Segoe UI, Roboto, Arial, sans-serif;
      background: var(--cream);
      color: var(--text);
      line-height: 1.5;
    }

    a {
      color: inherit;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(255, 250, 243, 0.96);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(10px);
    }

    .nav {
      width: min(1080px, calc(100% - 32px));
      min-height: 64px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--teal-dark);
      text-decoration: none;
      font-weight: 900;
      letter-spacing: -0.03em;
      line-height: 1.08;
    }

    .brand img {
      width: 34px;
      height: 34px;
      object-fit: contain;
      border-radius: 8px;
    }

    .brand small {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 0.73rem;
      font-weight: 700;
      letter-spacing: 0;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 15px;
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 750;
      white-space: nowrap;
    }

    .nav-links a {
      text-decoration: none;
    }

    .nav-links a:hover {
      color: var(--teal-dark);
    }

    .nav-cta {
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--teal-dark);
      color: var(--cream) !important;
    }

    .wrap {
      width: min(1080px, calc(100% - 32px));
      margin: 0 auto;
    }

    .hero {
      padding: 38px 0 14px;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--teal);
      font-size: 0.76rem;
      font-weight: 950;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      max-width: 760px;
      color: var(--teal-dark);
      font-size: clamp(2rem, 4.5vw, 3.35rem);
      line-height: 1.04;
      letter-spacing: -0.055em;
    }

    .hero-text {
      max-width: 720px;
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 0.98rem;
    }

    .section {
      padding: 18px 0;
    }

    .section-title {
      margin: 0 0 12px;
      color: var(--teal-dark);
      font-size: clamp(1.3rem, 2.4vw, 1.9rem);
      line-height: 1.12;
      letter-spacing: -0.04em;
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 9px;
    }

    .step-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 13px;
      box-shadow: 0 8px 22px rgba(7, 55, 52, 0.04);
    }

    .step-number {
      display: inline-flex;
      width: 24px;
      height: 24px;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--teal-dark);
      color: var(--cream);
      font-size: 0.82rem;
      font-weight: 950;
      margin-bottom: 8px;
    }

    .step-card h3 {
      margin: 0 0 4px;
      color: var(--teal-dark);
      font-size: 0.92rem;
      line-height: 1.18;
    }

    .step-card p {
      margin: 0;
      color: var(--muted);
      font-size: 0.83rem;
      line-height: 1.4;
    }

    .option-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 12px 0 14px;
    }

    .option-tab {
      cursor: pointer;
      text-align: left;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--card);
      padding: 16px;
      box-shadow: var(--shadow);
      color: var(--text);
      transition: 0.16s ease;
    }

