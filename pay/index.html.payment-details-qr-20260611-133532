      transform: translateY(-1px);
      border-color: rgba(15, 118, 110, 0.35);
    }

    .option-tab.active {
      border: 2px solid var(--teal);
      background: linear-gradient(180deg, #ffffff 0%, #f3fbf8 100%);
    }

    .tab-label {
      display: inline-flex;
      width: fit-content;
      margin-bottom: 7px;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(45, 212, 191, 0.14);
      color: var(--teal);
      font-size: 0.68rem;
      font-weight: 950;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .option-tab h3 {
      margin: 0 0 5px;
      color: var(--teal-dark);
      font-size: clamp(1.02rem, 2vw, 1.32rem);
      line-height: 1.12;
      letter-spacing: -0.035em;
    }

    .tab-price {
      margin: 0;
      color: var(--teal-dark);
      font-size: clamp(1.75rem, 3.5vw, 2.35rem);
      font-weight: 950;
      letter-spacing: -0.06em;
      line-height: 1;
    }

    .tab-summary {
      margin: 9px 0 0;
      color: var(--muted);
      font-size: 0.9rem;
      line-height: 1.42;
    }

    .details-panel {
      display: none;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: clamp(17px, 2.8vw, 24px);
      box-shadow: var(--shadow);
    }

    .details-panel.active {
      display: block;
    }

    .details-top {
      display: grid;
      grid-template-columns: 1.35fr 0.65fr;
      gap: 16px;
      align-items: start;
    }

    .details-panel h2 {
      margin: 0 0 7px;
      color: var(--teal-dark);
      font-size: clamp(1.38rem, 2.8vw, 2.05rem);
      line-height: 1.08;
      letter-spacing: -0.045em;
    }

    .details-price {
      margin: 0;
      color: var(--teal-dark);
      font-size: clamp(2.15rem, 5vw, 3.45rem);
      font-weight: 950;
      letter-spacing: -0.07em;
      line-height: 1;
      text-align: right;
    }

    .details-summary {
      max-width: 680px;
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.54;
    }

    .includes {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin: 16px 0 0;
      padding: 0;
      list-style: none;
    }

    .includes li {
      position: relative;
      padding: 9px 11px 9px 32px;
      border-radius: 11px;
      background: #f7fbf8;
      border: 1px solid rgba(7, 55, 52, 0.08);
      color: var(--text);
      font-size: 0.89rem;
      font-weight: 700;
      line-height: 1.32;
    }

    .includes li::before {
      content: "✓";
      position: absolute;
      left: 12px;
      top: 9px;
      color: var(--teal);
      font-weight: 950;
    }

