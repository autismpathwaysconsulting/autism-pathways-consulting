{
  "name": "autism-pathways-consulting-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:pathway-preview": "node pathway-preview/scripts/build.mjs",
    "sync:video-rules": "node scripts/sync-video-rules.mjs",
    "test:site-build": "node --test tests/site-build-output.test.mjs",
    "test:content-os": "node --test tests/content-os*.test.mjs",
    "test:episode-workflow": "node --test tests/content-os-episode-workflow.test.mjs",
    "test:pathway-preview": "node --test pathway-preview/tests/*.test.mjs",
    "test": "npm run test:content-os && npm run test:episode-workflow && npm run test:pathway-preview"
  }
}
