  document.getElementById('payAmt').textContent = amt;
  document.getElementById('payLabel').textContent = name + ' · ' + desc;
  document.getElementById('qrAmt').textContent = amt;
  document.getElementById('qrLabel').textContent = name;
  document.getElementById('bankAmt').textContent = amt;
  const confirmSection = document.getElementById('confirm-before-paying');
  if (confirmSection) {
    setTimeout(() => {
      confirmSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 120);
  }
}

function switchTab(tab) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelector('[onclick="switchTab(\''+tab+'\')"]').classList.add('active');
  document.getElementById('panel-'+tab).classList.add('active');
}
function copyText(text, btn) {
  navigator.clipboard.writeText(text).then(() => {
    btn.textContent = 'Copied!'; btn.classList.add('copied');
    setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
  });
}
</script>

