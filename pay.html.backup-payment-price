<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--teal:#2a9d8f;--teal-d:#1e7268;--text:#1a1a2e;--muted:#6b7280;--bg:#faf9f7;--card:#fff;--border:#e8e4df;--pink:#e84393}
body{overflow-x:hidden;font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;padding-bottom:60px}
a{color:inherit;text-decoration:none}
nav{background:var(--teal);padding:0 24px}
.nav-inner{max-width:480px;margin:0 auto;display:flex;align-items:center;height:56px;gap:16px}
.nav-logo{font-family:'DM Serif Display',serif;font-size:16px;color:#fff}
.nav-back{font-size:14px;color:rgba(255,255,255,.8);margin-left:auto}
.container{max-width:480px;margin:0 auto;padding:28px 16px 0}
/* Step label */
.step-label{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
/* Session card */
.pkg-grid{display:flex;flex-direction:column;gap:10px;margin-bottom:24px}
.pkg-card{border:2px solid var(--border);border-radius:14px;padding:18px;cursor:pointer;transition:all .18s;background:var(--card)}
.pkg-card:hover{border-color:var(--teal)}
.pkg-card.active{border-color:var(--teal);background:#f0faf9}
.pkg-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px}
.pkg-name{font-weight:700;font-size:15px}
.pkg-price{font-family:'DM Serif Display',serif;font-size:1.6rem;color:var(--teal)}
.pkg-save{font-size:11px;font-weight:700;color:var(--teal);background:#d4f0eb;padding:2px 8px;border-radius:10px;margin-left:6px;vertical-align:middle}
.pkg-desc{font-size:13px;color:var(--muted);margin-bottom:10px}
.pkg-includes{list-style:none;padding:0;border-top:1px solid var(--border);padding-top:10px;display:grid;grid-template-columns:1fr 1fr;gap:4px}
.pkg-includes li{font-size:12px;color:var(--muted);padding-left:14px;position:relative}
.pkg-includes li::before{content:'✓';position:absolute;left:0;color:var(--teal);font-weight:700}
/* Cal.com step */
.cal-box{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:24px;margin-bottom:24px}
.cal-box p{font-size:14px;color:var(--muted);margin-bottom:16px}
.cal-btn{display:block;background:var(--teal);color:#fff;text-align:center;padding:14px;border-radius:10px;font-weight:700;font-size:15px}
.cal-btn:hover{background:var(--teal-d)}
.cal-note{font-size:12px;color:var(--muted);margin-top:8px;text-align:center}
/* Method tabs */
.method-tabs{display:flex;gap:8px;margin-bottom:16px}
.tab-btn{flex:1;padding:10px;border-radius:10px;border:1.5px solid var(--border);background:var(--card);font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;transition:all .18s;text-align:center}
.tab-btn.active{border-color:var(--teal);background:var(--teal);color:#fff}
.panel{display:none}
.panel.active{display:block}
/* QR */
.qr-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:24px;text-align:center}
.qr-amount{font-family:'DM Serif Display',serif;font-size:2rem;color:var(--teal);margin-bottom:4px}
.qr-label{font-size:13px;color:var(--muted);margin-bottom:16px}
.qr-img-wrap{display:inline-block;background:#fff;border-radius:10px;padding:6px;border:1px solid var(--border)}
.qr-img-wrap img{width:240px;height:auto;display:block}
.qr-caption{margin-top:12px;font-size:13px;color:var(--muted)}
.duitnow-badge{margin-top:12px;display:inline-flex;align-items:center;gap:6px;background:#fff0f6;border:1px solid #fbc8df;border-radius:20px;padding:6px 14px;font-size:12px;font-weight:600;color:var(--pink)}
/* Bank */
.bank-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.bank-header{background:var(--teal);color:#fff;padding:12px 18px;font-weight:700;font-size:14px}
.bank-body{overflow-x:hidden;padding:16px 18px}
.bank-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);gap:10px}
.bank-row:last-child{border-bottom:none}
.bank-row .lbl{font-size:12px;color:var(--muted);font-weight:500;min-width:90px}
.bank-row .val{font-size:14px;font-weight:700;text-align:right;flex:1}
.copy-btn{background:var(--teal);color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer}
.copy-btn.copied{background:#10b981}
/* Notice */
.notice-box{margin-top:20px;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:16px;font-size:13px;color:#92400e}
/* Trust */
.trust-bar{margin-top:20px;display:flex;justify-content:center;gap:20px;flex-wrap:wrap}
.trust-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);font-weight:500}

@media(max-width:480px){
  .container{padding:20px 14px 0}
  .pkg-includes{grid-template-columns:1fr}
  .method-tabs{gap:6px}
  .tab-btn{font-size:12px;padding:8px}
  .qr-img-wrap img{width:200px}
  .trust-bar{gap:12px}
}

@media(max-width:600px){
