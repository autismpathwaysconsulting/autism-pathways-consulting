  .cred-grid{grid-template-columns:1fr}
  .service-section{padding:24px 18px}
  .pricing-grid{grid-template-columns:1fr}
  .svc-cta{flex-direction:column}
  .svc-cta a{text-align:center}
  .btn-primary,.btn-secondary,.btn-main,.btn-ghost{width:100%;text-align:center;padding:13px 20px}
  .form-row{flex-direction:column}
  .pkg-grid .pkg-card{padding:16px}
  .pkg-includes{grid-template-columns:1fr}
  .method-tabs{gap:6px}
  .tab-btn{font-size:12px;padding:9px}
  .nav-links a:not(.nav-cta){display:none}
  .about-inner,.about-in{flex-direction:column;text-align:center}
  .cta-box{padding:24px 18px}
  .unsure{padding:28px 20px}
  .school-form-wrap{padding:18px 16px}
  details summary{font-size:13px}
  .steps-label{font-size:11px}
}
@media(max-width:360px){
  h1{font-size:1.5rem}
