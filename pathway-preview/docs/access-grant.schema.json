{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autismpathwaysconsulting.com/schemas/access-grant.schema.json",
  "title": "APC portal account access grant",
  "description": "A revocable, least-privilege grant for one verified adult account. This is an implementation candidate, not an approved access policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "clientProfileId", "accountHolderId", "consentRecordId", "scopes", "status", "issuedAt", "issuedBy"],
  "properties": {
    "id": { "type": "string", "pattern": "^ACCESS-[A-Z0-9-]{8,}$" },
    "clientProfileId": { "type": "string", "pattern": "^APC-[A-Z]+-[0-9]{3,}$" },
    "accountHolderId": { "type": "string", "pattern": "^ACCOUNT-[A-Z0-9-]{8,}$" },
    "consentRecordId": { "type": "string", "pattern": "^CONSENT-[A-Z0-9-]{8,}$" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["view-published-pathway", "view-resources", "submit-journal", "request-booking", "upload-media", "export-own-records"] }
    },
    "status": { "enum": ["pending", "active", "suspended", "expired", "revoked"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "issuedBy": { "type": "string", "pattern": "^OPERATOR-[A-Z0-9-]{6,}$" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "revokedAt": { "type": ["string", "null"], "format": "date-time" },
    "revocationReasonCode": { "enum": ["service-ended", "consent-withdrawn", "security", "authority-changed", "operator-decision", "not-applicable"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "revoked" } } },
      "then": {
        "properties": {
          "revokedAt": { "type": "string", "format": "date-time" },
          "revocationReasonCode": { "enum": ["service-ended", "consent-withdrawn", "security", "authority-changed", "operator-decision"] }
        },
        "required": ["revokedAt", "revocationReasonCode"]
      }
    }
  ]
}
